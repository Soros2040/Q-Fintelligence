{
  "name": "q-fintelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "predev": "npm run build --workspace @q-fintelligence/contracts",
    "dev": "QF_PROCESS_NAMESPACE=qfintelligence QF_RUNTIME_PROCESS_REGISTRY_REQUIRED=1 node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @q-fintelligence/control-plane",
    "dev:web": "npm run dev --workspace @q-fintelligence/web",
    "build": "npm run build --workspace @q-fintelligence/contracts && npm run build --workspace @q-fintelligence/control-plane && npm run build --workspace @q-fintelligence/web",
    "typecheck": "npm run typecheck --workspace @q-fintelligence/contracts && npm run typecheck --workspace @q-fintelligence/control-plane && npm run typecheck --workspace @q-fintelligence/web",
    "test": "vitest run",
    "check": "npm run ports:check && npm run typecheck && npm run test && npm run build",
    "ports:check": "node scripts/port-guard.mjs --check",
    "status": "node scripts/status.mjs",
    "stop": "node scripts/stop.mjs",
    "doctor": "bash infra/wsl/doctor.sh",
    "campaign:doctor": "node scripts/campaign.mjs doctor",
    "campaign:test": "vitest run tests/typescript/campaign-*.test.ts && uv run pytest tests/python/test_p02_science.py tests/python/test_p03_tianyan.py tests/python/test_p04_tool_factory.py",
    "campaign:start": "node scripts/campaign.mjs start",
    "campaign:status": "node scripts/campaign.mjs status",
    "campaign:audit": "node scripts/campaign.mjs audit",
    "campaign:tianyan-probe": "node scripts/campaign.mjs tianyan-probe",
    "campaign:tianyan176-hardware": "node scripts/campaign.mjs tianyan176-hardware",
    "campaign:tianyan-config": "node scripts/campaign.mjs tianyan-config",
    "campaign:p03-sse": "node scripts/campaign.mjs p03-sse",
    "campaign:p03-old-cloud": "node scripts/campaign.mjs p03-old-cloud",
    "campaign:p03-queue-step": "node scripts/campaign.mjs p03-queue-step",
    "campaign:p03-queue-resume": "node scripts/campaign.mjs p03-queue-resume",
    "campaign:p03-queue-status": "node scripts/campaign.mjs p03-queue-status",
    "campaign:p03-queue-stop": "node scripts/campaign.mjs p03-queue-stop",
    "campaign:p03-finalize": "node scripts/campaign.mjs p03-finalize",
    "campaign:p04-init": "node scripts/campaign.mjs p04-init",
    "campaign:p04-start": "node scripts/p04.mjs start",
    "campaign:p04-status": "node scripts/p04.mjs status",
    "campaign:p04-resume-lane": "node scripts/p04.mjs resume-lane",
    "campaign:p04-stop-lane": "node scripts/p04.mjs stop-lane",
    "campaign:p04-inject-science": "node scripts/p04.mjs inject-science",
    "campaign:p04-inject-query": "node scripts/p04.mjs inject-query",
    "campaign:p04-stop": "node scripts/p04.mjs stop",
    "campaign:p04-record-tests": "node scripts/campaign.mjs p04-record-tests",
    "campaign:p04-finalize": "node scripts/campaign.mjs p04-finalize",
    "campaign:p04-final-gates": "node scripts/p04-final-gates.mjs",
    "campaign:p04-monitor": "node scripts/p04-monitor.mjs",
    "acceptance:openhands:start": "node scripts/openhands-acceptance.mjs start",
    "acceptance:openhands:status": "node scripts/openhands-acceptance.mjs status",
    "acceptance:openhands:resume-lane": "node scripts/openhands-acceptance.mjs resume-lane",
    "acceptance:openhands:inject-fault": "node scripts/openhands-acceptance.mjs inject-fault",
    "acceptance:openhands:finalize": "node scripts/openhands-acceptance.mjs finalize",
    "acceptance:openhands:stop": "node scripts/openhands-acceptance.mjs stop",
    "test:openhands-sidecar": "cd workers/openhands_sidecar && uv run --with pytest==9.0.1 pytest && uv run --with ruff==0.14.7 ruff check .",
    "p15:tushare": "node --env-file-if-exists=.env --import tsx scripts/p15-prepare-tushare.ts",
    "campaign:resume": "node scripts/campaign.mjs resume",
    "campaign:stop": "node scripts/campaign.mjs stop"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
